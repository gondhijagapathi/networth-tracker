# ---------------------------------------------------------------------------
# Net Worth Tracker — copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
# Bind to loopback only. Change to 0.0.0.0 ONLY behind a TLS reverse proxy.
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Single SQLite file. The directory is created on boot if missing.
DATABASE_PATH=./data/networth.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# --- Auth ---
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-different-value-openssl-rand-base64-48
# Encrypts server-readable secrets at rest (TOTP seeds, later provider credentials).
# Rotating this makes every enrolled second factor unreadable, so keep it out of the
# JWT rotation story and back it up with the database.
SECRET_ENCRYPTION_KEY=replace-me-third-distinct-value-openssl-rand-base64-48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Set true when served over HTTPS so cookies carry the Secure flag. Exactly `true` or
# `false` — anything else is a boot-time error rather than a guess, because guessing wrong
# in either direction is bad: `true` on a plain-HTTP install makes the browser drop the
# session cookie and login silently does nothing, and `false` behind TLS ships the session
# without the flag. Required to be `true` when NODE_ENV=production.
COOKIE_SECURE=false

# --- Bootstrap ---
# First-run admin invite code. Used once to create the admin account, then
# every further account is created by admin-issued invite.
BOOTSTRAP_INVITE_CODE=change-me-before-first-run

# --- Backups ---
# Nightly automated backup (cron syntax). Empty disables the schedule.
BACKUP_CRON=0 2 * * *
# How many nightly bundles to keep. Bundles you took by hand are never pruned.
BACKUP_RETENTION=14
# The passphrase the nightly bundle is sealed with. REQUIRED for scheduled backups:
# with this unset the schedule does not run at all, because a bundle is never written
# unencrypted. `npm run backup` reads it too, and prompts when it is missing.
# A bundle is your whole installation in one file — use a long phrase, and store it
# somewhere other than this machine.
BACKUP_PASSPHRASE=

# --- Price providers ---
# AMFI daily NAV dump — free, no API key required.
AMFI_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt
NAV_REFRESH_CRON=30 20 * * 1-5
# Stock price provider: manual | yahoo
STOCK_PRICE_PROVIDER=manual

# --- Notifications (optional; used by dead-man switch warnings) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Docker Compose only (ignored when running from source) ---
# Host port the stack is published on. Its own variable rather than WEB_PORT above, which is
# the Vite dev server and has nothing to do with a container deployment.
NETWORTH_HTTP_PORT=8080
# Interface the port is published on. Loopback by default; set 0.0.0.0 ONLY when a TLS proxy
# on another host is what reaches it.
NETWORTH_BIND=127.0.0.1
# Cron expressions match the server's LOCAL time. Without this the container runs on UTC and
# the "nightly" backup fires at 02:00 UTC.
TZ=Asia/Kolkata
# Compose pins NODE_ENV, COOKIE_SECURE, API_HOST, DATABASE_PATH, UPLOAD_DIR and BACKUP_DIR
# itself, and ignores whatever this file says about them: the values above describe a host
# filesystem and a dev server, neither of which means the same thing inside a container.
# See docs/DEPLOYMENT.md.
