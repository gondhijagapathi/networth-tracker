{
  "name": "@networth/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:generate": "npx --yes drizzle-kit@0.31.10 generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:status": "tsx --env-file-if-exists=../../.env src/db/cli.ts status",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/cli/backup.ts create",
    "backup:list": "tsx --env-file-if-exists=../../.env src/cli/backup.ts list",
    "restore": "tsx --env-file-if-exists=../../.env src/cli/backup.ts restore",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@networth/shared": "*",
    "@node-rs/argon2": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
